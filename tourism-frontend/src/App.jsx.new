import { useEffect, useState } from 'react';
import { Routes, Route, Link, useParams, useNavigate } from 'react-router-dom';
import axios from 'axios';
import './index.css';

// 1. Khai báo URL của Backend
const BASE_URL = "http://127.0.0.1:8000";

// --- COMPONENT TRANG CHI TIẾT ĐỊA ĐIỂM ---
function LocationDetail() {
  const { id } = useParams();
  const navigate = useNavigate();
  const [location, setLocation] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    setLoading(true);
    axios.get(`${BASE_URL}/api/locations/${id}`)
      .then(res => {
        setLocation(res.data);
        setLoading(false);
        if(res.data) document.title = res.data.name;
      })
      .catch(err => {
        console.error("Lỗi lấy chi tiết địa điểm:", err);
        setLoading(false);
      });
  }, [id]);

  if (loading) return <div className="text-center py-20 font-bold text-blue-600 italic">Đang tải thông tin...</div>;
  if (!location) return <div className="text-center py-20 text-red-500">Không tìm thấy địa điểm.</div>;

  return (
    <div className="min-h-screen bg-white">
      {/* Banner Ảnh lớn */}
      <div className="relative h-[65vh] w-full overflow-hidden">
        <img 
          src={`${BASE_URL}/storage/images/${location.image_thumbnail}`} 
          className="w-full h-full object-cover transition-transform duration-1000 hover:scale-105"
          alt={location.name}
          onError={(e) => e.target.src = 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?q=80&w=1500'}
        />
        <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>
        
        <button 
          onClick={() => navigate(-1)}
          className="absolute top-8 left-8 bg-white/20 backdrop-blur-md text-white p-4 rounded-full shadow-2xl hover:bg-white hover:text-blue-900 transition-all z-10"
        >
          ← Quay lại
        </button>

        <div className="absolute bottom-16 left-12 text-white">
            <span className="uppercase tracking-[0.4em] text-xs font-black text-blue-400 bg-blue-950/60 px-4 py-2 rounded-lg mb-4 inline-block">
                {location.category?.name} | {location.province?.name}
            </span>
            <h1 className="text-7xl font-black drop-shadow-2xl italic uppercase leading-tight">{location.name}</h1>
        </div>
      </div>

      <div className="max-w-6xl mx-auto px-8 py-20">
        <div className="flex flex-col lg:flex-row gap-16">
          
          {/* Nội dung bài viết bên trái */}
          <div className="flex-1">
            <div className="flex items-center text-gray-800 mb-10 pb-8 border-b border-gray-100">
              <span className="text-4xl mr-4">📍</span>
              <span className="text-2xl font-semibold tracking-tight">{location.address}</span>
            </div>

            {/* Render HTML từ database và căn đều chữ */}
            <div 
                className="prose prose-2xl max-w-none text-gray-700 text-justify custom-article-style leading-relaxed"
                dangerouslySetInnerHTML={{ __html: location.content }}
            />
          </div>

          {/* Cột phải: Thẻ thông tin & Bản đồ */}
          <div className="w-full lg:w-96">
            <div className="bg-gray-50 p-10 rounded-[2.5rem] border border-gray-100 sticky top-10 shadow-sm">
              <h3 className="text-2xl font-black mb-6 text-blue-900 uppercase italic">Thông tin du khách</h3>
              <p className="text-gray-600 leading-relaxed mb-8 text-justify">
                Địa điểm này thuộc địa phận <strong>{location.province?.name}</strong>. 
                Vui lòng giữ gìn vệ sinh chung và tuân thủ các quy định tại điểm tham quan.
              </p>

              {location.latitude && location.longitude ? (
                <a 
                  href={`https://www.google.com/maps/search/?api=1&query=${location.latitude},${location.longitude}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="w-full flex items-center justify-center gap-3 bg-blue-600 text-white py-5 rounded-2xl font-black hover:bg-blue-700 transition-all shadow-xl shadow-blue-200 uppercase tracking-widest text-sm"
                >
                  🗺️ Mở Google Maps
                </a>
              ) : (
                <div className="p-4 bg-yellow-50 border border-yellow-100 rounded-xl text-yellow-700 text-sm italic text-center">
                  Tọa độ đang được cập nhật
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

// --- COMPONENT TRANG DANH SÁCH THEO TỈNH ---
function ProvinceDetail() {
  const { id } = useParams();
  const [locations, setLocations] = useState([]);
  const [province, setProvince] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    setLoading(true);
    
    // Gọi song song 2 API: Thông tin tỉnh và Danh sách địa điểm
    const fetchProvince = axios.get(`${BASE_URL}/api/provinces/${id}`);
    const fetchLocations = axios.get(`${BASE_URL}/api/provinces/${id}/locations`);

    Promise.all([fetchProvince, fetchLocations])
      .then(([provinceRes, locationsRes]) => {
        setProvince(provinceRes.data);
        setLocations(locationsRes.data);
        setLoading(false);
        if(provinceRes.data) document.title = `Khám phá ${provinceRes.data.name}`;
      })
      .catch(err => {
        console.error("Lỗi tải dữ liệu tỉnh:", err);
        setLoading(false);
      });
  }, [id]);

  if (loading) return <div className="flex justify-center items-center min-h-screen text-blue-600 font-bold italic">Đang tìm kiếm dữ liệu...</div>;

  return (
    <div className="min-h-screen bg-gray-50 pb-24">
      {/* Banner Tỉnh */}
      <div className="bg-blue-800 text-white py-24 px-8 mb-16 relative overflow-hidden">
        <div className="max-w-7xl mx-auto relative z-10">
          <Link to="/" className="text-blue-300 hover:text-white mb-8 inline-block font-bold tracking-widest uppercase text-xs">
            ← Quay lại trang chủ
          </Link>
          <h2 className="text-7xl font-black italic uppercase tracking-tighter">
            {province?.name || "Địa phương"}
          </h2>
          <p className="mt-6 text-blue-100 text-xl max-w-2xl leading-relaxed italic opacity-80">
            {province?.description || `Khám phá những điều tuyệt vời nhất tại ${province?.name}.`}
          </p>
        </div>
        <div className="absolute top-0 right-0 w-1/3 h-full bg-white/5 skew-x-12 transform translate-x-20"></div>
      </div>

      <div className="max-w-7xl mx-auto px-8">
        {locations.length > 0 ? (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-12">
            {locations.map(loc => (
              <div key={loc.id} className="bg-white rounded-[2rem] shadow-sm hover:shadow-2xl transition-all duration-500 overflow-hidden border border-gray-100 group">
                <div className="flex flex-col sm:flex-row">
                  <div className="w-full sm:w-64 h-64 overflow-hidden">
                      <img 
                          src={`${BASE_URL}/storage/images/${loc.image_thumbnail}`} 
                          className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                          alt={loc.name}
                          onError={(e) => e.target.src = 'https://images.unsplash.com/photo-1528127269322-539801943592?q=80&w=500'}
                      />
                  </div>
                  <div className="p-10 flex-1 flex flex-col justify-between">
                    <div>
                      <span className="inline-block px-4 py-1 text-[10px] font-black uppercase tracking-[0.2em] text-blue-600 bg-blue-50 rounded-full mb-4">
                          {loc.category?.name || "Du lịch"}
                      </span>
                      <Link to={`/location/${loc.id}`}>
                          <h3 className="text-3xl font-bold text-gray-900 hover:text-blue-600 transition-colors mb-3 uppercase leading-tight italic">{loc.name}</h3>
                      </Link>
                      <p className="text-gray-400 text-sm flex items-center mb-4 font-medium">
                          📍 {loc.address}
                      </p>
                    </div>
                    <Link 
                      to={`/location/${loc.id}`}
                      className="mt-6 text-sm font-black text-blue-600 flex items-center gap-2 group-hover:gap-4 transition-all uppercase tracking-widest"
                    >
                      Chi tiết hành trình →
                    </Link>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div className="text-center py-32 bg-white rounded-[3rem] border-2 border-dashed border-gray-200">
            <p className="text-gray-300 text-2xl italic font-medium">Hiện tại chưa có dữ liệu địa điểm cho tỉnh này.</p>
          </div>
        )}
      </div>
    </div>
  );
}

const removeVietnameseTones = (str) => {
    if (!str) return "";
    return str
        .normalize('NFD') // Tách các ký tự dấu ra khỏi chữ cái gốc
        .replace(/[\u0300-\u036f]/g, '') // Xóa các ký tự dấu
        .replace(/đ/g, 'd').replace(/Đ/g, 'D') // Xử lý chữ đ
        .toLowerCase() // Chuyển về chữ thường
        .trim();
};

// --- TRANG CHỦ ---
function Home({ provinces }) {
  const [searchTerm, setSearchTerm] = useState("");
  const filteredProvinces = provinces.filter(p => 
    p.name.toLowerCase().includes(searchTerm.toLowerCase())
  );

  return (
    <div className="min-h-screen bg-gray-50">
      <div className="bg-blue-950 py-32 px-8 text-center text-white relative">
        <h1 className="text-8xl font-black mb-8 tracking-tighter uppercase italic">VinaTour</h1>
        <p className="text-blue-300 mb-12 text-2xl font-light tracking-widest uppercase">Khám phá vẻ đẹp 63 tỉnh thành</p>
        <div className="max-w-3xl mx-auto">
          <input 
            type="text" 
            placeholder="Bạn muốn đi đâu? Nhập tên tỉnh thành..." 
            className="w-full px-12 py-6 rounded-3xl text-gray-900 focus:outline-none shadow-2xl text-xl border-8 border-blue-900/50"
            onChange={(e) => setSearchTerm(e.target.value)}
          />
        </div>
      </div>

      <div className="max-w-7xl mx-auto p-12 -mt-16 relative z-20">
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12">
          {filteredProvinces.map(p => (
            <Link to={`/province/${p.id}`} key={p.id} className="group bg-white rounded-[3rem] shadow-xl overflow-hidden hover:-translate-y-3 transition-all duration-500">
              <div className="relative h-80">
                <img 
                  src={`${BASE_URL}/storage/images/provinces/${p.image}`} 
                  className="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000"
                  alt={p.name}
                />
                <div className="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
                <div className="absolute bottom-8 left-10">
                    <p className="text-blue-400 font-black text-xs tracking-widest mb-2 uppercase">{p.locations_count || 0} Địa điểm</p>
                    <h3 className="text-4xl font-black text-white uppercase italic tracking-tighter">{p.name}</h3>
                </div>
              </div>
              <div className="p-10">
                <p className="text-gray-500 leading-relaxed line-clamp-3 mb-8 text-justify italic">
                  {p.description || `Khám phá nét đẹp văn hóa và thắng cảnh độc đáo tại ${p.name}.`}
                </p>
                <div className="flex items-center text-blue-600 font-black text-xs tracking-[0.3em] uppercase">
                  Khám phá ngay →
                </div>
              </div>
            </Link>
          ))}
        </div>
      </div>
    </div>
  );
}

// --- APP CHÍNH ---
function App() {
  const [provinces, setProvinces] = useState([]);

  useEffect(() => {
    axios.get(`${BASE_URL}/api/provinces`)
      .then(res => setProvinces(res.data))
      .catch(err => console.error("Lỗi API:", err));
  }, []);

  return (
    <Routes>
      <Route path="/" element={<Home provinces={provinces} />} />
      <Route path="/province/:id" element={<ProvinceDetail />} />
      <Route path="/location/:id" element={<LocationDetail />} />
    </Routes>
  );
}

export default App;